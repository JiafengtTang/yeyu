{
  "name": "@yeyu/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "内网自建的小型管理工具：台账登记 + 定期图文汇报",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "build:mac": "pnpm run build && electron-builder --mac --config electron-builder.yml",
    "build:win": "pnpm run build && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@yeyu/shared": "workspace:*",
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "@types/node": "^22.9.0"
  }
}
