{
  "name": "yeyu",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "concurrently -n server,desktop -c blue,magenta \"pnpm run dev:server\" \"pnpm run dev:desktop\"",
    "dev:server": "pnpm --filter @yeyu/server dev",
    "dev:desktop": "pnpm --filter @yeyu/desktop dev",
    "db:push": "pnpm --filter @yeyu/server db:push",
    "db:seed": "pnpm --filter @yeyu/server db:seed",
    "test": "pnpm --filter @yeyu/server test",
    "typecheck": "pnpm -r typecheck",
    "build:mac": "pnpm --filter @yeyu/desktop build:mac",
    "build:win": "pnpm --filter @yeyu/desktop build:win",
    "start": "bash scripts/start-local.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
